  ]
 },
 "class_rules": {
  "gate": "on fail => read_only",
  "selftest": "measured under LAB-SELFTEST, on fail => cap_off",
  "ops": "capability-scoped, on fail => cap_off",
  "env": "documented, never blocks"
 }
